    "Works anywhere, even when the panel is closed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Works anywhere, even when the panel is closed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无论面板是否展开都生效。"
          }
        }
      }
    },
    "Shortcuts inside the panel need the panel to take keyboard focus (General → Take Keyboard Focus)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shortcuts inside the panel need the panel to take keyboard focus (General → Take Keyboard Focus)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面板内的快捷键需要面板接管键盘焦点（通用 → 接管键盘焦点）。"
          }
        }
      }
    },
    "While typing in the chat input, only Close or go back and Allow the pending request still work." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While typing in the chat input, only Close or go back and Allow the pending request still work."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在聊天输入框里打字时，只有「返回或收起」与「批准待处理的请求」仍然生效。"
          }
        }
      }
    },
    "That key is already used by “%@”." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
