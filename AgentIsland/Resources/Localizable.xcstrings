    },
    "Status check %@ · session scan %@" : {
      "comment" : "刷新频率行：分别显示会话状态复核和磁盘会话扫描的间隔。",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status check %@ · session scan %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "状态复核 %@ · 会话扫描 %@"
          }
        }
      }
    },
    "Requires a tmux session and yabai; otherwise opens chat." : {
      "comment" : "聚焦终端单击动作的前置条件和回退行为。",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requires a tmux session and yabai; otherwise opens chat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 tmux 会话和 yabai；否则改为打开对话。"
          }
        }
      }
    },
    "Environment directory: %@" : {
      "comment" : "Codex / Grok 环境变量指定的实际配置根目录。",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environment directory: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "环境变量目录：%@"
          }
        }
      }
    },
    "OMP approval wait budget is not active. Re-enable OMP to retry; approvals may time out sooner than expected." : {
      "comment" : "OMP 闸门扩展已装，但应用写入 handler 等待预算失败时的行内警告。",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OMP approval wait budget is not active. Re-enable OMP to retry; approvals may time out sooner than expected."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OMP 的审批等待预算未生效。重新启用 OMP 可重试；等待时间可能短于预期。"
          }
        }
      }
    },
    "Select the folder where %@ installs its hooks. Session records remain in VS Code global storage." : {
      "comment" : "Cline 目录选择器仅指定 hook 安装位置，不改变 VS Code 中的会话记录位置。",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select the folder where %@ installs its hooks. Session records remain in VS Code global storage."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择 %@ 安装 hook 的目录。会话记录仍保存在 VS Code 全局存储中。"
          }
        }
      }
    },
    "This session has no process or tmux pane to focus." : {
      "comment" : "会话行「去终端」按钮禁用（仅凭记录发现的会话）时工具提示",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This session has no process or tmux pane to focus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个会话没有可定位的进程或 tmux 面板。"
          }
        }
      }
    },
    "Take Keyboard Focus" : {
      "comment" : "通用页系统组：面板展开时是否抢键盘焦点",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take Keyboard Focus"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接管键盘焦点"
          }
        }
      }
    },
    "Move keyboard focus to the panel when it opens. Turn this off to keep typing in your editor while the notch is open." : {
      "comment" : "「接管键盘焦点」行的工具提示",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move keyboard focus to the panel when it opens. Turn this off to keep typing in your editor while the notch is open."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面板展开时把键盘焦点移到面板上。关掉它，刘海开着时也能继续在编辑器里打字。"
          }
        }
      }
    },
    "Turned off %@ and removed its integration." : {
      "comment" : "智能体页：单行关闭某个 Agent 后的回执行",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turned off %@ and removed its integration."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关闭 %@ 并移除其集成。"
          }
        }
      }
    },
    "%@ · %@ to %@" : {
      "comment" : "微调行的工具提示与无障碍值：标签 · 下限 到 上限",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ to %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ 到 %@"
          }
        }
      }
